public class Loops {

	/**
	 * @param args
	 */
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		for (int i = 0; i < 3; i++) {
			System.out.println("Hellow");
		}
		
		System.out.println("\n");
		int a = 2;
		for (int i = 0; i < a; i++) {
			System.out.println("Hellow");
		}
		
	}
}
