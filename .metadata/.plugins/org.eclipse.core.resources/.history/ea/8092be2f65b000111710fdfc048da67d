public class RelationalAndLogical {
	public static void main(String[] args) {
		int a = 5;
		int b = 3;
		
		// Increment
		a = a + 2; // a += 2;
		System.out.println(a);
		System.out.println("b Before = " + b++);
		System.out.println("b After = " + ++b);
		
		// Decrement
		a = a - 3; // a -= 3;
		System.out.println(a);
		System.out.println("b Before = " + b--);
		System.out.println("b After = " + --b);
		
		// Other Simplifications
		a *= 2;
		b /= 3;
		System.out.println("a = " + a + " & b = " + b);
		
		boolean ans1 = a == b;
		System.out.println("Boolean Condition Checking (a == b): " + ans1);
		
		boolean ans2 = a > b;
		System.out.println("Boolean Condition Checking (a > b): " + ans2);
		
		boolean ans3 = a >= b;
		System.out.println("Boolean Condition Checking (a >= b): " + ans3);
		
		boolean ans4 = a < b;
		System.out.println("Boolean Condition Checking (a < b): " + ans4);
		
		boolean ans5 = a <= b;
		System.out.println("Boolean Condition Checking (a <= b): " + ans5);
	}
}
