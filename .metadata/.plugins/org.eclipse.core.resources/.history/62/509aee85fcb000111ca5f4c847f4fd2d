package loops;

/**
 *  @author Unbothered (Mirza Md Ashif Iqbal)
 */
public class Loops {

	/**
	 * @param args
	 */
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		for (int i = 0; i < 3; i++) {
			System.out.println("Hellow");
		}
		
		System.out.println("\n");
		int a = 3;
		for (int i = 0; i < a; i++) {
			System.out.println(i);
		}
		
		// Infinite Loop:
		//	while (a < 5) {
		//		System.out.println("Hellow");			
		//	}
		
		// This won't work!
		System.out.println("\n \n");
		while (a < 5) {
			System.out.println("Hellow");
			a++;
		}
		
		// Print "Hellow" only once!
		System.out.println("\n \n");
		while (a < 10) {
			System.out.println("Hellow");
			break;
		}
		
		// Normal Condition-wise printing
		int b = 1;
		System.out.println("\n");
		while (b < 10) {
			System.out.println("Hello!");
			b++;
		}
		
		System.out.println("\n");
		while (a < 10) {
			a++;
			// 'Continue' means go to the next record of the loop.
			// Here, it will print "Hellow" for a = 3,4,5,6,7,9 (not for a = 8)
			if (a == 8) {
				continue;
			}
			System.out.println("Hellow");
		}
		
		// Normal Condition-wise printing
		do {
			System.out.println("Hello World!");
			b++;
		} while (b < 14);
	}
}
