package Challenges;

import java.util.Random;
import java.util.Scanner;

/**
 *  @author Unbothered (Mirza Md Ashif Iqbal)
 */

public class guessTheNumber {

	/**
	 * @param args
	 */
	
	public static void main(String[] args) {
		// TODO 
		/**
		 * We are going to make a GAME!
		 *
		 * The concept is: Generate a random number and ask the user to guess the number,
		 * continue asking until you receive the number
		 * after 5 times of guessing show a game over message
		 *
		 *
		 * Here is how it works:
		 * Show a welcome message
		 * Ask the User's name and say hello to the user
		 * Ask if we should start the game
		 * After receiving a positive answer generate a random number and ask for the user's guess
		 * If the guess is correct show a congratulation message and quit the game
		 * If the number is not correct, ask again until you receive the correct answer
		 * As a hint, 
		 * 		beside the first time, 
		 * 		every time that you are asking for a number, 
		 * 		tell the user to guess higher or lower.
		 * If the User failed 5 times, show a game over message and quit the game
		 */
		Scanner sc = new Scanner (System.in);
		
		System.out.println("Welcome to Wonderland \n");
		System.out.print("May I have your name? - ");
		
		String name = sc.nextLine();
		
		System.out.println("Hello " + name + "\n");
		// sc.nextLine();
		
		System.out.println("Shall we start? - ");
		System.out.print("\t1. Yes");
		System.out.println("\t2. No");
		
		System.out.print("Response: ");
		int beginGame = sc.nextInt();
		int count = 1;
		
		while (beginGame == 1) {

			System.out.println("Yes. - Sure! Guess the random number.");
			System.out.print("Generating a random number between 1 - 37...\n");
			
			Random rand = new Random();
			int randNum =  6;// rand.nextInt(37) + 1; 
			
			System.out.println("Random number has been generated. ");
			System.out.print("Make your guess - ");
			int guess = sc.nextInt();
			
			do {
				count++;
				if (count > 5) {
					System.out.println("You have failed.");
					System.out.println("The random number is - " + randNum);
					break;
				}
				
				System.out.println("Your Guess: " + guess);
				if (guess > randNum) {
					System.out.println("You have guessed higher. Try a little lower value!");
				} 
				else if (guess < randNum) {
					System.out.println("You have guessed lower. Try a little higher value!");
				} 
				else {
					System.out.println("Invalid Input!");
				}
				System.out.print("Guess Again - ");
				guess = sc.nextInt();
			} while (guess != randNum);
			
			if ( guess == randNum) {
				System.out.println("You have guessed it right! Congratulations!");
				System.out.println("The Random Number Is - " + randNum);
				System.out.println("Your Guess was: " + guess);
				System.out.println("Chance Took to Guess: " + count + "\n");
			}
			
			System.out.println("Want to play again? - ");
			System.out.print("\t1. Yes");
			System.out.println("\t2. No");
			System.out.print("Response: ");
			beginGame = sc.nextInt();
		} 
		
		if (beginGame == 2) {
			System.out.println("We will meet again soon!");
			System.out.println("Till then, Good Bye!");
			
		} else {
			System.out.println("Invalid Input");
			
		}
		
		sc.close();
	}

}
