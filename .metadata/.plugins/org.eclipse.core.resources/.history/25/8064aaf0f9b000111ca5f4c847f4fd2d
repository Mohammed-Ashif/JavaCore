package loops;

/**
 *  @author Unbothered (Mirza Md Ashif Iqbal)
 */
public class Loops {

	/**
	 * @param args
	 */
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		for (int i = 0; i < 3; i++) {
			System.out.println("Hellow");
		}
		
		System.out.println("\n");
		int a = 3;
		for (int i = 0; i < a; i++) {
			System.out.println(i);
		}
		
// Infinite Loop:
//		while (a < 5) {
//			System.out.println("Hellow");			
//		}
		
		System.out.println("\n");
		while (a < 10) {
			System.out.println("Hellow");
			a++;
		}
		
		// Print "Hellow" only once!
		System.out.println("\n \n");
		while (a < 10) {
			System.out.println("Hellow");
			break;
		}
	}
}
